# Required in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Make.com Custom Webhook URL for the lead-scoring scenario.
# If unset, submissions are logged instead of sent (fine for local dev only).
MAKE_WEBHOOK_URL=

# Public origin, used for canonical URLs, Open Graph tags and sitemap.xml. No trailing slash.
SITE_URL=http://localhost:5000

CONTACT_EMAIL=hello@jengo.example

# Reverse proxies in front of the app. Railway and Render both use 1. Set 0 if nothing proxies the app.
TRUSTED_PROXY_COUNT=1

# Rate-limit storage. The default memory:// is per worker; set a Redis URL (redis://...) to share limits.
RATELIMIT_STORAGE_URI=memory://

# Set to 1 locally for auto-reload and debug pages.
FLASK_DEBUG=0
